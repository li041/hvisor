spi2: spi@feb20000{
  compatible = "rockchip,rk3066-spi";
  reg = <0x0 0xfeb20000 0x0 0x1000>;
  interrupts = <0 328 4>;
  #address-cells = <1>;
  #size-cells = <0>;
  num-cs = <2>;
 assigned-clock-rates = <200000000>;
 status = "disable";
 };
gpio0: gpio@fd8a0000 {
   compatible = "rockchip,gpio-bank";
   reg = <0x0 0xfd8a0000 0x0 0x100>;
   interrupts = <0 277 4>;

   gpio-controller;
   #gpio-cells = <2>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };


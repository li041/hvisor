  compatible = "rockchip,rk3588-ehci", "generic-ehci";
  reg = <0x0 0xfc880000 0x0 0x40000>;
  interrupts = <0 218 4>;
  //clocks = <&cru 415>, <&cru 416>, <&u2phy3>;
  //clock-names = "usbhost", "arbiter", "utmi";
  companion = <&usb_host1_ohci>;
  phys = <&u2phy3_host>;

gpu_fixed_clk: gpu-fixed-clk {
    compatible = "fixed-clock";
    #clock-cells = <0>;
    clock-frequency = <198000000>; /* 这里填你的固定频率，单位Hz */
};

clk_gpu_coregroup: gpu-fixed-clk1 {
    compatible = "fixed-clock";
    #clock-cells = <0>;
    clock-frequency = <198000000>; /* 这里填你的固定频率，单位Hz */
};
clk_gpu_stacks: gpu-fixed-clk2 {
    compatible = "fixed-clock";
    #clock-cells = <0>;
    clock-frequency = <198000000>; /* 这里填你的固定频率，单位Hz */
};
clk_gpu: gpu-fixed-clk3 {
    compatible = "fixed-clock";
    #clock-cells = <0>;
    clock-frequency = <198000000>; /* 这里填你的固定频率，单位Hz */
};



gpu_static_pd: gpu-static-power {
    compatible = "simple-power-domain";
    #power-domain-cells = <0>;
    status = "okay"; /* always-on */
};


gpu: gpu@fb000000 {
  compatible = "arm,mali-bifrost";
  reg = <0x0 0xfb000000 0x0 0x200000>;
  interrupts = <0 94 4>,
        <0 93 4>,
        <0 92 4>;
  interrupt-names = "GPU", "MMU", "JOB";

  clocks = <&gpu_fixed_clk>,<&clk_gpu_coregroup>,<&clk_gpu_stacks>,<&clk_gpu>;
  clock-names = "clk_mali","clk_gpu_coregroup","clk_gpu_stacks", "clk_gpu";

  //power-domains = <&gpu_static_pd>;
   power-domains = <&power 12>;
  assigned-clocks = <&scmi_clk 5>;
  assigned-clock-rates = <200000000>;
  #cooling-cells = <2>;
  //dynamic-power-coefficient = <2982>;

  //upthreshold = <30>;
  //downdifferential = <10>;
  //mali-supply = <&vdd_gpu_s0>;
  //mem-supply = <&vdd_gpu_mem_s0>;
  status = "okay";
 };






		
    chosen {
		bootargs = "earlycon=virtio,mmio,0xff9b0000 console=hvc0 root=/dev/vda rootwait rw loglevel=9 clk_ignore_unused";
//		stdout-path = "/virtio_mmio@0xff9b0000";
	};
};
&spi2 {
 status = "okay";
 assigned-clock-rates = <200000000>;
 num-cs = <1>;

 rk806single: rk806single@0 {
  compatible = "rockchip,rk806";
  spi-max-frequency = <1000000>;
  reg = <0x0>;

  interrupt-parent = <&gpio0>;
  interrupts = <7 8>;
  low_voltage_threshold = <3000>;
  shutdown_voltage_threshold = <2700>;
  shutdown_temperture_threshold = <160>;
  hotdie_temperture_threshold = <115>;
  pmic-reset-func = <1>;
};
};
